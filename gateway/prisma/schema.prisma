generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tipos y estados posibles, según el enunciado del TP.
// Los vehículos (y sus enums) pasaron al Vehicle Service en el Hito 2.
// Los clientes pasaron al Customer Service en el Hito 2.
enum EstadoReserva {
  CONFIRMADA
  CANCELADA
  FINALIZADA
}

enum RolUsuario {
  CLIENTE
  ADMIN
}

model Reserva {
  id           Int           @id @default(autoincrement())
  clienteId    Int // referencia lógica al Customer Service (otra base, sin FK)
  vehiculoId   Int // referencia lógica al Vehicle Service (otra base, sin FK)
  fechaInicio  DateTime
  fechaFin     DateTime
  precioDiario Decimal       @db.Decimal(10, 2) // se guarda el precio del momento
  importeTotal Decimal       @db.Decimal(10, 2)
  estado       EstadoReserva @default(CONFIRMADA)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Usuario {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(CLIENTE)
  clienteId    Int?       @unique // referencia lógica al Customer Service (otra base, sin FK)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}