generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tipos y estados posibles, según el enunciado del TP.
// Los vehículos pasaron al Vehicle Service, los clientes al Customer Service
// y las reservas/alquileres al Rental Service (Hito 2).
enum RolUsuario {
  CLIENTE
  ADMIN
}

model Usuario {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  rol          RolUsuario @default(CLIENTE)
  clienteId    Int?       @unique // referencia lógica al Customer Service (otra base, sin FK)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}